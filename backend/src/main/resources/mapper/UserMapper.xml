<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neighborhood.mapper.UserMapper">
    
    <select id="selectByPhone" resultType="com.neighborhood.entity.User">
        SELECT * FROM users WHERE phone = #{phone}
    </select>
    
    <select id="selectByOpenid" resultType="com.neighborhood.entity.User">
        SELECT * FROM users WHERE openid = #{openid}
    </select>
    
</mapper>
