/* iconfont.wxss - 图标字体 */
/* 引入 iconfont 图标字体 */
@font-face {
  font-family: 'iconfont';
  src: url('https://at.alicdn.com/t/font_xxxxx.ttf') format('truetype');
}

.iconfont {
  font-family: "iconfont" !important;
  font-size: 16px;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

