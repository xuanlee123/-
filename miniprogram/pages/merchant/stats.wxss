/* pages/merchant/stats.wxss - 商户数据统计 */
page {
  background-color: #F5F6FA;
}

.stats-container {
  min-height: 100vh;
  background-color: #F5F6FA;
  padding-bottom: 120rpx;
}

/* 加载状态 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E0E0E0;
  border-top-color: #00B894;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #999;
}

/* 商户入驻信息卡片 */
.merchant-card {
  margin: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
}

.merchant-header {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
  margin-bottom: 24rpx;
}

.merchant-avatar {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #00B894 0%, #00A388 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.merchant-avatar text {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.merchant-info {
  flex: 1;
}

.merchant-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.merchant-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.status-badge {
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
}

.status-badge.pending {
  background: #FFF3E0;
  color: #FF9800;
}

.status-badge.approved {
  background: #E8F5E9;
  color: #4CAF50;
}

.status-badge.rejected {
  background: #FFEBEE;
  color: #F44336;
}

.merchant-type {
  font-size: 24rpx;
  color: #666;
}

.merchant-details {
  display: flex;
  flex-wrap: wrap;
}

.detail-item {
  width: 50%;
  padding: 12rpx 0;
}

.detail-item.full-width {
  width: 100%;
}

.detail-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 4rpx;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
}

/* 核心指标 */
.metrics-section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.metric-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.metric-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.metric-icon {
  font-size: 36rpx;
}

.metric-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.metric-label {
  font-size: 24rpx;
  color: #999999;
}

/* 评价概览 */
.evaluation-section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.evaluation-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.evaluation-score {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF9800;
  margin-bottom: 8rpx;
}

.score-label {
  font-size: 24rpx;
  color: #999;
}

.evaluation-divider {
  width: 1rpx;
  height: 80rpx;
  background: #E0E0E0;
  margin: 0 40rpx;
}

.evaluation-total {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.total-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.total-label {
  font-size: 24rpx;
  color: #999;
}

/* 账户余额 */
.balance-section {
  padding: 0 24rpx;
}

.balance-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
}

.balance-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.balance-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.withdraw-btn {
  font-size: 28rpx;
  color: #00B894;
}

.balance-row {
  display: flex;
  justify-content: center;
}

.balance-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 60rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
}

.balance-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.balance-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.balance-value.income {
  color: #FF5252;
}
