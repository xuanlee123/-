/* pages/merchant/mine.wxss - 商户我的页面 */
page {
  background-color: var(--bg-page);
}

.mine-container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding-bottom: 120rpx;
}

/* 商户信息卡片 */
.merchant-card {
  background-color: var(--primary-color);
  padding: 48rpx 32rpx;
}

.merchant-info {
  display: flex;
  align-items: center;
}

.merchant-avatar {
  width: 120rpx;
  height: 120rpx;
  background-color: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
}

.avatar-text {
  font-size: 60rpx;
}

.merchant-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.merchant-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 10rpx;
}

.merchant-status {
  display: flex;
  align-items: center;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.status-dot.online {
  background-color: #67C23A;
}

.status-dot.offline {
  background-color: rgba(255, 255, 255, 0.5);
}

.status-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.edit-btn {
  background-color: rgba(255, 255, 255, 0.25);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
}

.edit-text {
  font-size: 26rpx;
  color: #FFFFFF;
}

/* 统计数据 */
.stats-section {
  margin: 24rpx 32rpx;
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 32rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: var(--border-light);
}

/* 功能菜单区域 */
.menu-section {
  margin: 24rpx 32rpx;
  background-color: var(--bg-card);
  border-radius: 20rpx;
  overflow: hidden;
}

.section-title {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background-color: var(--bg-gray);
}

.title-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.title-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.menu-list {
  padding: 0 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.menu-arrow {
  font-size: 28rpx;
  color: var(--text-placeholder);
}

.menu-badge {
  background-color: var(--danger-color);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

/* 退出登录 */
.logout-section {
  margin: 48rpx 32rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background-color: var(--bg-card);
  border: none;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: var(--danger-color);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-btn::after {
  border: none;
}
