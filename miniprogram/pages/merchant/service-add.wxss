/* pages/merchant/service-add.wxss */
page {
  background-color: var(--bg-page);
}

.container {
  min-height: 100vh;
  padding: 20rpx 30rpx;
  padding-bottom: 180rpx;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.form-item {
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.form-label.required::before {
  content: '*';
  color: var(--danger-color);
  margin-right: 4rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  line-height: 1.6;
}

.form-hint {
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 12rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.category-item {
  padding: 16rpx 32rpx;
  background: var(--bg-gray);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.category-item.selected {
  background: var(--primary-light);
  color: var(--primary-color);
  border-color: var(--primary-color);
}

.price-input-wrapper {
  display: flex;
  align-items: center;
  background: var(--bg-gray);
  border-radius: 12rpx;
  padding: 0 20rpx;
}

.price-input-wrapper::before {
  content: '¥';
  font-size: 28rpx;
  color: var(--text-secondary);
}

.price-input {
  flex: 1;
  height: 80rpx;
  padding: 0 10rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.image-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.image-label {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.image-label.required::before {
  content: '*';
  color: var(--danger-color);
  margin-right: 4rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  position: relative;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.image-delete {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: var(--bg-gray);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--border-color);
}

.add-icon {
  font-size: 60rpx;
  color: var(--text-placeholder);
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #ccc;
}

.switch-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.switch-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}
