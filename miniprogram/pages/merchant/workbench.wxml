<!--pages/merchant/workbench.wxml - 商户工作台-->
<view class="workbench-container">
  <!-- 加载状态 -->
  <view class="loading-mask" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 头部统计卡片 -->
  <view class="stats-header">
    <view class="stats-bg"></view>
    <view class="stats-content">
      <view class="welcome-section">
        <view class="welcome-text">
          <text class="welcome-title">{{merchantInfo.name || '商户'}}</text>
          <view class="status-badge {{merchantInfo.statusClass}}">
            <text>{{merchantInfo.statusText}}</text>
          </view>
        </view>
        <view class="merchant-type" wx:if="{{merchantInfo.type}}">
          <text>{{merchantInfo.type}}</text>
        </view>
      </view>

      <!-- 核心数据统计 -->
      <view class="stats-grid">
        <view class="stat-item">
          <text class="stat-value">{{stats.todayOrders}}</text>
          <text class="stat-label">今日订单</text>
        </view>
        <view class="stat-item">
          <text class="stat-value income">¥{{stats.todayIncome}}</text>
          <text class="stat-label">今日收入</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{stats.pendingOrders}}</text>
          <text class="stat-label">待处理</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{stats.services}}</text>
          <text class="stat-label">我的服务</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="section-card">
    <view class="section-title">
      <text class="title-icon">⚙️</text>
      <text class="title-text">运营管理</text>
    </view>
    <view class="function-grid">
      <view class="function-item" bindtap="goToService">
        <view class="function-icon-box" style="background: linear-gradient(135deg, #E8F8F5 0%, #D4EFDF 100%)">
          <text class="function-icon">🧹</text>
        </view>
        <text class="function-text">服务管理</text>
        <view class="badge" wx:if="{{stats.services > 0}}">{{stats.services}}</view>
      </view>
      <view class="function-item" bindtap="goToOrder">
        <view class="function-icon-box" style="background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%)">
          <text class="function-icon">📋</text>
        </view>
        <text class="function-text">订单管理</text>
        <view class="badge danger" wx:if="{{stats.pendingOrders > 0}}">{{stats.pendingOrders}}</view>
      </view>
      <view class="function-item" bindtap="goToStats">
        <view class="function-icon-box" style="background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%)">
          <text class="function-icon">📊</text>
        </view>
        <text class="function-text">数据统计</text>
      </view>
      <view class="function-item" bindtap="goToCoupon">
        <view class="function-icon-box" style="background: linear-gradient(135deg, #F3E5F5 0%, #E1BEE7 100%)">
          <text class="function-icon">🎟️</text>
        </view>
        <text class="function-text">优惠券</text>
      </view>
    </view>
  </view>

  <!-- 本月数据概览 -->
  <view class="section-card">
    <view class="section-title">
      <text class="title-icon">📈</text>
      <text class="title-text">本月概览</text>
    </view>
    <view class="month-stats">
      <view class="month-stat-item">
        <view class="month-stat-icon" style="background: #E8F5E9">
          <text>📦</text>
        </view>
        <view class="month-stat-info">
          <text class="month-stat-value">{{stats.monthOrders}}</text>
          <text class="month-stat-label">完成订单</text>
        </view>
      </view>
      <view class="month-stat-divider"></view>
      <view class="month-stat-item">
        <view class="month-stat-icon" style="background: #FFF3E0">
          <text>⭐</text>
        </view>
        <view class="month-stat-info">
          <text class="month-stat-value">{{stats.averageScore}}</text>
          <text class="month-stat-label">平均评分</text>
        </view>
      </view>
      <view class="month-stat-divider"></view>
      <view class="month-stat-item">
        <view class="month-stat-icon" style="background: #E3F2FD">
          <text>💬</text>
        </view>
        <view class="month-stat-info">
          <text class="month-stat-value">{{stats.totalEvaluations}}</text>
          <text class="month-stat-label">收到评价</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="section-card">
    <view class="section-title">
      <text class="title-icon">⚡</text>
      <text class="title-text">快捷操作</text>
    </view>
    <view class="quick-grid">
      <view class="quick-item" bindtap="goToAddService">
        <view class="quick-icon-box">
          <text>➕</text>
        </view>
        <text class="quick-text">添加服务</text>
      </view>
      <view class="quick-item" bindtap="goToAddCoupon">
        <view class="quick-icon-box">
          <text>🎫</text>
        </view>
        <text class="quick-text">创建优惠券</text>
      </view>
      <view class="quick-item" bindtap="goToWithdraw">
        <view class="quick-icon-box">
          <text>💰</text>
        </view>
        <text class="quick-text">提现</text>
      </view>
      <view class="quick-item" bindtap="goToSettings">
        <view class="quick-icon-box">
          <text>⚙️</text>
        </view>
        <text class="quick-text">店铺设置</text>
      </view>
    </view>
  </view>

  <!-- 待处理订单 -->
  <view class="section-card" wx:if="{{pendingOrders.length > 0}}">
    <view class="section-header">
      <view class="section-title-row">
        <text class="title-icon">⏰</text>
        <text class="title-text">待处理订单</text>
        <view class="badge danger" wx:if="{{pendingOrders.length > 0}}">{{pendingOrders.length}}</view>
      </view>
      <view class="more-btn" bindtap="goToOrder">
        <text>查看全部</text>
        <text class="arrow">></text>
      </view>
    </view>
    <view class="pending-list">
      <view class="pending-item" wx:for="{{pendingOrders}}" wx:key="id" bindtap="goToOrderDetail" data-id="{{item.id}}">
        <view class="pending-left">
          <view class="pending-service">{{item.serviceName || '服务'}}</view>
          <view class="pending-meta">
            <text class="pending-time">{{item.createTime}}</text>
            <text class="pending-address" wx:if="{{item.addressDetail}}">📍 {{item.addressDetail}}</text>
          </view>
        </view>
        <view class="pending-right">
          <text class="pending-price">¥{{item.price || item.amount || 0}}</text>
          <view class="pending-actions" catchtap="noop">
            <view class="action-btn reject" catchtap="rejectOrder" data-id="{{item.id}}">拒单</view>
            <view class="action-btn accept" catchtap="acceptOrder" data-id="{{item.id}}">接单</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 无待处理订单 -->
  <view class="empty-pending" wx:if="{{!loading && pendingOrders.length === 0}}">
    <text class="empty-icon">✅</text>
    <text class="empty-text">暂无待处理订单</text>
  </view>
</view>

<!-- 自定义TabBar -->
<custom-tab-bar role="merchant" active="/pages/merchant/workbench" />
