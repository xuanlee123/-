/* pages/merchant/workbench.wxss - 商户工作台 */
page {
  background-color: #F5F6FA;
}

.workbench-container {
  min-height: 100vh;
  background-color: #F5F6FA;
  padding-bottom: 120rpx;
}

/* 加载状态 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E0E0E0;
  border-top-color: #00B894;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #999;
}

/* 头部统计卡片 */
.stats-header {
  position: relative;
  margin: 0 24rpx;
  margin-top: 20rpx;
}

.stats-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(135deg, #00B894 0%, #00A388 100%);
  border-radius: 24rpx;
}

.stats-content {
  position: relative;
  padding: 40rpx 32rpx;
}

.welcome-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 40rpx;
}

.welcome-text {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.welcome-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
}

.merchant-type {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 核心数据网格 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.stat-value.income {
  color: #FFE082;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 通用卡片 */
.section-card {
  margin: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.title-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 功能入口 */
.function-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.function-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.function-icon-box {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.function-icon {
  font-size: 40rpx;
}

.function-text {
  font-size: 24rpx;
  color: #333;
}

.badge {
  position: absolute;
  top: -4rpx;
  right: 8rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #00B894;
  color: #FFFFFF;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.badge.danger {
  background: #FF5252;
}

/* 本月数据 */
.month-stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.month-stat-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.month-stat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.month-stat-info {
  display: flex;
  flex-direction: column;
}

.month-stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.month-stat-label {
  font-size: 22rpx;
  color: #999;
}

.month-stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #E0E0E0;
}

/* 快捷操作 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.quick-item:active {
  transform: scale(0.95);
  background: #F0F0F0;
}

.quick-icon-box {
  width: 64rpx;
  height: 64rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.quick-text {
  font-size: 22rpx;
  color: #666;
}

/* 待处理订单 */
.more-btn {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
}

.arrow {
  margin-left: 4rpx;
}

.pending-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pending-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
}

.pending-left {
  flex: 1;
}

.pending-service {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.pending-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pending-time {
  font-size: 22rpx;
  color: #999;
}

.pending-address {
  font-size: 22rpx;
  color: #666;
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pending-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.pending-price {
  font-size: 30rpx;
  font-weight: bold;
  color: #FF5252;
}

.pending-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.action-btn.reject {
  background: #F5F5F5;
  color: #666;
}

.action-btn.accept {
  background: linear-gradient(135deg, #00B894 0%, #00A388 100%);
  color: #FFFFFF;
}

/* 空状态 */
.empty-pending {
  margin: 40rpx 24rpx;
  padding: 60rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
