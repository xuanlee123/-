/* index.wxss - 首页 */
page {
  background-color: var(--bg-page);
}

.index-container {
  background-color: var(--bg-page);
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 搜索横幅 */
.search-banner {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: var(--bg-card);
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: var(--bg-gray);
  border-radius: 40rpx;
  padding: 20rpx 28rpx;
  margin-right: 24rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: var(--text-placeholder);
}

.search-btn {
  background-color: var(--primary-color);
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
}

.search-btn-text {
  font-size: 26rpx;
  color: #FFFFFF;
}

/* 热门服务轮播 */
.hot-service-section {
  padding: 32rpx;
  background-color: var(--bg-card);
  margin-bottom: 20rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-more {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

.banner-swiper {
  height: 200rpx;
}

.hot-service-card {
  display: flex;
  border-radius: 20rpx;
  overflow: hidden;
  height: 200rpx;
}

.hot-service-card.card-1 {
  background-color: #EDF4FC;
}

.hot-service-card.card-2 {
  background-color: #EEF5FB;
}

.hot-service-card.card-3 {
  background-color: #F6F4F1;
}

.hot-service-image {
  width: 200rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hot-image {
  width: 100%;
  height: 100%;
}

.hot-service-card.card-1 .hot-service-image {
  background-color: #D8E7F8;
}

.hot-service-card.card-2 .hot-service-image {
  background-color: #D4E8F5;
}

.hot-service-card.card-3 .hot-service-image {
  background-color: #E8E6E1;
}

.service-icon {
  font-size: 72rpx;
}

.hot-service-content {
  flex: 1;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hot-tag {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 500;
  margin-bottom: 8rpx;
}

.hot-price {
  font-size: 44rpx;
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.hot-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 服务分类 */
.category-section {
  padding: 32rpx;
  background-color: var(--bg-card);
  margin-bottom: 20rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.category-icon-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.category-icon-emoji {
  font-size: 48rpx;
}

.category-name {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 社区公告 */
.announcement-section {
  padding: 32rpx;
  background-color: var(--bg-card);
  margin-bottom: 20rpx;
}

.announcement-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.announcement-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background-color: var(--bg-gray);
  border-radius: 12rpx;
}

.announcement-title {
  font-size: 28rpx;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.announcement-date {
  font-size: 22rpx;
  color: var(--text-placeholder);
  margin-left: 20rpx;
  flex-shrink: 0;
}

/* 社区活动 */
.activity-section {
  padding: 32rpx;
  background-color: var(--bg-card);
  margin-bottom: 20rpx;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.activity-card {
  background-color: var(--bg-gray);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.activity-card.empty {
  padding: 48rpx 32rpx;
}

.empty-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 8rpx;
}

.activity-cover {
  position: relative;
  width: 100%;
  height: 320rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.activity-cover .cover-img {
  width: 100%;
  height: 100%;
}

.activity-cover .cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.activity-cover .cover-icon {
  font-size: 100rpx;
  opacity: 0.8;
}

.activity-status-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

.activity-status-tag.status-0 {
  background-color: #00B894;
}

.activity-status-tag.status-1 {
  background-color: #F39C12;
}

.activity-status-tag.status-2 {
  background-color: #3498DB;
}

.activity-status-tag.status-3 {
  background-color: #95A5A6;
}

.activity-content {
  padding: 24rpx;
}

.activity-header {
  margin-bottom: 12rpx;
}

.activity-title {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.activity-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.activity-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.activity-meta .meta-icon {
  font-size: 26rpx;
}

.activity-meta .meta-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

