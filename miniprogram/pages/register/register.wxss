/* pages/register/register.wxss - 论文风格注册页 */
page {
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
}

/* 头部 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 60rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #81C784 100%);
}

.logo-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 注册表单 */
.register-form {
  padding: 60rpx 50rpx 0;
}

/* 输入项 */
.input-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #e0e0e0;
  padding: 0 24rpx;
  margin-bottom: 30rpx;
  height: 100rpx;
}

.input-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.input-field {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #333;
}

/* 用户类型选择 */
.role-section {
  margin-bottom: 40rpx;
}

.role-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.role-options {
  display: flex;
  gap: 30rpx;
}

.role-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid #e0e0e0;
}

.role-option.active {
  border-color: #4CAF50;
  background: #e8f5e9;
}

.role-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.role-text {
  font-size: 28rpx;
  color: #333;
}

/* 注册按钮 */
.btn-register {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C61 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.3);
}

.btn-register::after {
  border: none;
}

.btn-register:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 登录链接 */
.login-link {
  margin-top: 50rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

.link-text {
  color: #FF6B35;
  margin-left: 8rpx;
}
