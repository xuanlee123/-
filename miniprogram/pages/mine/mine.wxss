/* pages/mine/mine.wxss - 个人中心 */
page {
  background-color: var(--bg-page);
}

.mine-container {
  background-color: var(--bg-page);
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 用户信息卡片 */
.user-section {
  padding: 0 32rpx;
  margin-top: -16rpx;
}

.user-card {
  background-color: var(--primary-color);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
}

.user-info {
  display: flex;
  align-items: center;
  position: relative;
}

.user-avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
}

.avatar-icon {
  font-size: 60rpx;
}

.user-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.edit-btn {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #FFFFFF;
  background-color: rgba(255, 255, 255, 0.25);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
}

/* 功能快捷入口 */
.quick-section {
  padding: 24rpx 32rpx;
}

.quick-grid {
  display: flex;
  justify-content: space-around;
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 32rpx 16rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-icon-box {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.quick-icon-emoji {
  font-size: 44rpx;
}

.quick-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 功能菜单 */
.menu-section {
  margin: 0 32rpx;
  background-color: var(--bg-card);
  border-radius: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-emoji {
  font-size: 36rpx;
  margin-right: 24rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
}

.menu-arrow {
  font-size: 28rpx;
  color: var(--text-placeholder);
}

/* 退出登录 */
.logout-section {
  padding: 48rpx 32rpx;
}

.logout-btn {
  width: 100%;
  background-color: var(--bg-card);
  color: var(--danger-color);
  font-size: 32rpx;
  font-weight: 500;
  padding: 28rpx 0;
  border-radius: 20rpx;
  border: none;
}

.logout-btn::after {
  border: none;
}
