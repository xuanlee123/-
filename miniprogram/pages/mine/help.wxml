<!--pages/mine/help.wxml - 帮助中心-->
<view class="help-container">
  <view class="help-list">
    <view class="help-item" wx:for="{{helpList}}" wx:key="index">
      <view class="help-q" bindtap="toggleHelp" data-index="{{index}}">
        <text class="q-icon">Q</text>
        <text class="q-text">{{item.title}}</text>
        <text class="q-arrow">{{item.expanded ? 'v' : '>'}}</text>
      </view>
      <view class="help-a" wx:if="{{item.expanded}}">
        <text class="a-icon">A</text>
        <text class="a-text">{{item.content}}</text>
      </view>
    </view>
  </view>
</view>
