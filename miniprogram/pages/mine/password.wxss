/* pages/mine/password.wxss - 修改密码 */
page {
  background-color: #F5F6FA;
}

.password-container {
  min-height: 100vh;
  background-color: #F5F6FA;
  padding-top: 20rpx;
}

.form-section {
  background-color: #FFFFFF;
  margin: 0 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.form-item:last-child {
  border-bottom: none;
}

.item-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.item-input {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
  background: none;
  border: none;
}

.item-input::placeholder {
  color: #CCCCCC;
}

.tip-section {
  padding: 24rpx 54rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999999;
}

.btn-section {
  padding: 60rpx 24rpx 0;
}

.btn-submit {
  width: 100%;
  background: linear-gradient(135deg, #00B894 0%, #00A388 100%);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: bold;
  padding: 28rpx 0;
  border-radius: 50rpx;
  border: none;
}

.btn-submit::after {
  border: none;
}
