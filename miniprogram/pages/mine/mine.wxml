<!--pages/mine/mine.wxml - 个人中心-->
<view class="mine-container">
  <!-- 用户信息卡片 -->
  <view class="user-section">
    <view class="user-card">
      <view class="user-info">
        <view class="user-avatar-placeholder">
          <text class="avatar-icon">👤</text>
        </view>
        <view class="user-detail">
          <text class="user-name">居民用户1</text>
          <text class="user-id">用户ID：13900000001</text>
        </view>
        <view class="edit-btn" bindtap="goToEdit">编辑</view>
      </view>
    </view>
  </view>

  <!-- 功能快捷入口 -->
  <view class="quick-section">
    <view class="quick-grid">
      <view class="quick-item" bindtap="goToOrder">
        <view class="quick-icon-box" style="background-color: #E8F8F5">
          <text class="quick-icon-emoji">📋</text>
        </view>
        <text class="quick-text">我的订单</text>
      </view>
      <view class="quick-item" bindtap="goToAddress">
        <view class="quick-icon-box" style="background-color: #FFF3E0">
          <text class="quick-icon-emoji">📍</text>
        </view>
        <text class="quick-text">收货地址</text>
      </view>
      <view class="quick-item" bindtap="goToCoupon">
        <view class="quick-icon-box" style="background-color: #FFF9C4">
          <text class="quick-icon-emoji">🎟️</text>
        </view>
        <text class="quick-text">优惠券</text>
      </view>
      <view class="quick-item" bindtap="goToCollection">
        <view class="quick-icon-box" style="background-color: #FFEBEE">
          <text class="quick-icon-emoji">⭐</text>
        </view>
        <text class="quick-text">我的收藏</text>
      </view>
      <view class="quick-item" bindtap="goToMerchant">
        <view class="quick-icon-box" style="background-color: #E3F2FD">
          <text class="quick-icon-emoji">🏪</text>
        </view>
        <text class="quick-text">入驻</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goToOrder">
      <text class="menu-icon-emoji">📋</text>
      <text class="menu-text">我的订单</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToAddress">
      <text class="menu-icon-emoji">📍</text>
      <text class="menu-text">收货地址</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToCoupon">
      <text class="menu-icon-emoji">🎟️</text>
      <text class="menu-text">优惠券</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToCollection">
      <text class="menu-icon-emoji">⭐</text>
      <text class="menu-text">我的收藏</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToMerchant">
      <text class="menu-icon-emoji">🏪</text>
      <text class="menu-text">商户入驻</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToHelp">
      <text class="menu-icon-emoji">❓</text>
      <text class="menu-text">帮助中心</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToSettings">
      <text class="menu-icon-emoji">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <!-- 自定义底部导航栏 -->
  <custom-tab-bar role="user" active="/pages/mine/mine"></custom-tab-bar>
</view>
