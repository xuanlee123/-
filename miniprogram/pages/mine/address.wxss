/* pages/mine/address.wxss - 收货地址 */
page {
  background-color: #F5F6FA;
}

.address-container {
  min-height: 100vh;
  background-color: #F5F6FA;
  padding: 20rpx 30rpx 180rpx;
}

/* 地址列表 */
.address-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.address-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
}

.address-main {
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
  margin-bottom: 20rpx;
}

.address-user {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-right: 20rpx;
}

.user-phone {
  font-size: 28rpx;
  color: #666666;
}

.address-detail {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
}

.address-actions {
  display: flex;
  justify-content: flex-end;
  gap: 30rpx;
}

.action-item {
  display: flex;
  align-items: center;
}

.action-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
}

.action-text {
  font-size: 26rpx;
  color: #666666;
}

.action-item.default .action-icon {
  color: #00B894;
}

.action-item.default .action-text {
  color: #00B894;
}

/* 添加地址按钮 */
.add-address-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  background: linear-gradient(135deg, #00B894 0%, #00A388 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  padding: 28rpx 0;
  border-radius: 50rpx;
  border: none;
}

.add-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.add-btn::after {
  border: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #999;
}

/* 选择模式 */
.address-card.selectable:active {
  background-color: #F0F9F8;
}

/* 默认标签 */
.default-tag {
  font-size: 22rpx;
  color: #00B894;
  background: rgba(0, 184, 148, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
}
