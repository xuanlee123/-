<!--pages/mine/password.wxml - 修改密码-->
<view class="password-container">
  <view class="form-section">
    <view class="form-item">
      <text class="item-icon">🔑</text>
      <input class="item-input" type="password" data-field="oldPassword" bindinput="onFieldChange" value="{{oldPassword}}" placeholder="请输入原密码" />
    </view>
    <view class="form-item">
      <text class="item-icon">🔒</text>
      <input class="item-input" type="password" data-field="newPassword" bindinput="onFieldChange" value="{{newPassword}}" placeholder="请输入新密码（至少6位）" />
    </view>
    <view class="form-item">
      <text class="item-icon">🔐</text>
      <input class="item-input" type="password" data-field="confirmPassword" bindinput="onFieldChange" value="{{confirmPassword}}" placeholder="请再次输入新密码" />
    </view>
  </view>

  <view class="tip-section">
    <text class="tip-text">密码规则：至少6位，建议包含字母和数字</text>
  </view>

  <view class="btn-section">
    <button class="btn-submit" bindtap="handleSubmit">确认修改</button>
  </view>
</view>
