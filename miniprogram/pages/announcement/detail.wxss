/* pages/announcement/detail.wxss - 公告详情 */
page {
  background-color: #F5F6FA;
}

.announcement-detail-container {
  min-height: 100vh;
  background-color: #F5F6FA;
  padding-bottom: 120rpx;
}

/* 公告头部 */
.announcement-header {
  display: flex;
  background-color: #FFFFFF;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.header-icon {
  width: 100rpx;
  height: 100rpx;
  background-color: #E8F8F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.header-icon-text {
  font-size: 50rpx;
}

.header-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.announcement-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.announcement-meta {
  display: flex;
  gap: 20rpx;
}

.meta-source,
.meta-date {
  font-size: 24rpx;
  color: #999999;
}

/* 公告内容 */
.announcement-content {
  background-color: #FFFFFF;
  padding: 30rpx;
}

.content-text {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.8;
  margin-bottom: 16rpx;
  display: block;
}

.content-section {
  margin: 20rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
  display: block;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx;
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.action-text {
  font-size: 22rpx;
  color: #666666;
}

/* 阅读统计栏 */
.stats-bar {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
  gap: 40rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  font-size: 26rpx;
}

.stat-text {
  font-size: 24rpx;
  color: #999999;
}

.urgency-tag {
  font-size: 22rpx;
  color: #FFFFFF;
  background-color: #FF4D4F;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 公告图片 */
.announcement-image {
  background-color: #FFFFFF;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
}

.announcement-image image {
  width: 100%;
  border-radius: 12rpx;
}

/* 加载/空状态 */
.loading-state,
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.loading-text,
.empty-text {
  font-size: 28rpx;
  color: #999999;
}
