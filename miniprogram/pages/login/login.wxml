<!--pages/login/login.wxml - 论文风格登录页 (深色主题)-->
<view class="login-container">
  <!-- 顶部装饰区域 -->
  <view class="header-section">
    <view class="logo-wrapper">
      <text class="logo-icon">🏠</text>
    </view>
    <text class="app-title">社区生活服务</text>
    <text class="app-subtitle">Community Life Services</text>
  </view>

  <!-- 登录表单区域 -->
  <view class="form-section">
    <!-- 角色选择 -->
    <view class="role-selector">
      <picker bindchange="onRoleChange" value="{{roleIndex}}" range="{{roles}}">
        <view class="picker-view">
          <text class="picker-label">登录身份</text>
          <view class="picker-value">
            <text>{{roles[roleIndex]}}</text>
            <text class="picker-arrow">v</text>
          </view>
        </view>
      </picker>
    </view>

    <!-- 手机号输入 -->
    <view class="input-group">
      <view class="input-row">
        <text class="input-prefix">+86</text>
        <input class="input-control" type="number" placeholder="请输入手机号" bindinput="onPhoneInput" value="{{phone}}" maxlength="11" />
      </view>
    </view>

    <!-- 密码输入 -->
    <view class="input-group">
      <view class="input-row">
        <text class="input-prefix">*</text>
        <input class="input-control" type="password" placeholder="请输入密码" bindinput="onPasswordInput" value="{{password}}" />
      </view>
    </view>

    <!-- 登录按钮 -->
    <button class="btn-login" bindtap="handleLogin">登 录</button>

    <!-- 注册链接 -->
    <view class="register-link">
      <text class="link-hint">还没有账号？</text>
      <text class="link-action" bindtap="goToRegister">立即注册</text>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer-section">
    <text class="footer-text">登录即表示同意</text>
    <text class="footer-link">《用户协议》</text>
    <text class="footer-text">和</text>
    <text class="footer-link">《隐私政策》</text>
  </view>
</view>
