/* neighborhood/list.wxss - 邻里圈 */
page {
  background-color: var(--bg-page);
}

.container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding-bottom: 120rpx;
}

/* 角色入口提示 */
.role-banner {
  background-color: var(--primary-light);
  padding: 20rpx 30rpx;
  text-align: center;
}

.role-text {
  color: var(--primary-color);
  font-size: 26rpx;
}

/* 标签栏 */
.post-tabs {
  display: flex;
  background-color: var(--bg-card);
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.post-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-placeholder);
  padding: 16rpx 0;
  position: relative;
}

.post-tab.active {
  color: var(--primary-color);
  font-weight: 500;
}

.post-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background-color: var(--primary-color);
  border-radius: 2rpx;
}

/* 帖子列表 */
.post-list {
  padding: 24rpx 32rpx;
}

.post-item {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.post-avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.avatar-text {
  font-size: 40rpx;
}

.post-user {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.post-username {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.post-time {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

.tag {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.tag-primary {
  background-color: var(--primary-light);
  color: var(--primary-color);
}

.tag-warning {
  background-color: #FDF6EC;
  color: var(--warning-color);
}

.post-content {
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.post-image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.post-image {
  width: 100%;
  height: 100%;
}

.post-image-placeholder {
  width: 200rpx;
  height: 200rpx;
  background-color: var(--bg-gray);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-text {
  font-size: 60rpx;
}

.post-actions {
  display: flex;
  gap: 64rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-light);
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  font-size: 32rpx;
}

.action-count {
  font-size: 26rpx;
  color: var(--text-placeholder);
}

.action-item.liked .action-count {
  color: var(--danger-color);
}

/* 头像图片 */
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 发布按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lg);
}

.fab-icon {
  font-size: 44rpx;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 60rpx;
  color: var(--text-placeholder);
  font-size: 26rpx;
}

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: var(--text-placeholder);
  font-size: 28rpx;
}
