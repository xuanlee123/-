/* neighborhood/publish.wxss */
page {
  background-color: var(--bg-page);
}

.publish-container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding-bottom: 160rpx;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: var(--bg-card);
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 40rpx;
  color: var(--text-primary);
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.nav-submit {
  padding: 12rpx 32rpx;
  background-color: var(--primary-color);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #FFFFFF;
}

.nav-submit.disabled {
  background-color: #CCCCCC;
}

/* 内容区域 */
.content-area {
  background-color: var(--bg-card);
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.content-input {
  width: 100%;
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.8;
  min-height: 300rpx;
  background: none;
  border: none;
}

.content-count {
  text-align: right;
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 16rpx;
}

/* 分类选择 */
.type-section {
  background-color: var(--bg-card);
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  display: block;
}

.type-list {
  display: flex;
  gap: 20rpx;
}

.type-item {
  padding: 16rpx 32rpx;
  background-color: var(--bg-gray);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid transparent;
}

.type-item.active {
  background-color: #E8F8F5;
  color: var(--primary-color);
  border-color: var(--primary-color);
}

/* 图片上传 */
.image-section {
  background-color: var(--bg-card);
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 24rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.uploaded-img {
  width: 100%;
  height: 100%;
}

.remove-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-image-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  border: 2rpx dashed var(--border-color);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: var(--bg-card);
}

.add-icon {
  font-size: 60rpx;
  color: var(--text-placeholder);
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

/* 底部发布栏 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  background-color: var(--bg-card);
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, #00A388 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}

.btn-submit::after {
  border: none;
}

.btn-submit.disabled {
  background: #CCCCCC;
}
