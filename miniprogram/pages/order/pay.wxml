<!--pages/order/pay.wxml - 订单支付-->
<view class="pay-container">
  <!-- 订单金额 -->
  <view class="amount-section">
    <text class="amount-label">支付金额</text>
    <view class="amount-wrap">
      <text class="amount-symbol">¥</text>
      <text class="amount-value">{{amount}}</text>
    </view>
    <text class="order-no">订单号：{{orderId}}</text>
  </view>

  <!-- 支付方式 -->
  <view class="payment-section">
    <view class="section-title">选择支付方式</view>
    <view class="payment-list">
      <view class="payment-item {{payMethod === 'wechat' ? 'active' : ''}}" bindtap="selectPayMethod" data-method="wechat">
        <view class="payment-icon-wrap wechat">
          <text class="payment-icon">💳</text>
        </view>
        <view class="payment-info">
          <text class="payment-name">微信支付</text>
          <text class="payment-desc">推荐</text>
        </view>
        <view class="payment-check">
          <text class="check-icon">{{payMethod === 'wechat' ? '✓' : ''}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 安全提示 -->
  <view class="safe-tip">
    <text class="safe-icon">🔒</text>
    <text class="safe-text">支付安全由微信支付提供保障</text>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <button class="pay-btn" bindtap="doPay" loading="{{paying}}">
      确认支付 ¥{{amount}}
    </button>
  </view>
</view>
