/* pages/order/create.wxss - 确认订单 */
page {
  background-color: var(--bg-page);
}

.create-container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding: 20rpx 30rpx 200rpx;
}

/* 地址卡片 */
.address-card {
  padding: 30rpx;
}

.address-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.address-info {
  flex: 1;
}

.address-user {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-right: 20rpx;
}

.user-phone {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.address-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.no-address {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.no-address-text {
  font-size: 28rpx;
  color: var(--text-placeholder);
}

.section-card {
  background-color: var(--bg-card);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.section-title-row {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.section-title-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.service-row {
  padding: 30rpx;
}

.service-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.service-name {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
  flex: 1;
}

.service-price {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.picker-row:last-child {
  border-bottom: none;
}

.picker-label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.picker-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.arrow {
  font-size: 32rpx;
  color: var(--text-placeholder);
}

.remark-input {
  width: 100%;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  min-height: 160rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
}

.price-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.price-value {
  font-size: 28rpx;
  color: var(--text-primary);
}

.total-row {
  border-top: 1rpx solid var(--border-light);
  padding-top: 24rpx;
  margin-top: 8rpx;
}

.total-price {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: var(--bg-card);
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.price-info {
  display: flex;
  flex-direction: column;
}

.price-info .price-label {
  font-size: 24rpx;
}

.price-info .total-price {
  font-size: 44rpx;
}

.submit-btn {
  background-color: var(--primary-color);
  color: #FFFFFF;
  padding: 24rpx 60rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.submit-btn::after {
  border: none;
}
