<!--pages/order/list.wxml - 订单列表-->
<view class="order-container">
  <!-- 状态标签栏 -->
  <view class="status-tabs">
    <view class="status-tab {{status === null ? 'active' : ''}}" bindtap="switchTab" data-status="null">
      <text>全部</text>
    </view>
    <view class="status-tab {{status === 0 ? 'active' : ''}}" bindtap="switchTab" data-status="0">
      <text>待付款</text>
    </view>
    <view class="status-tab {{status === 1 ? 'active' : ''}}" bindtap="switchTab" data-status="1">
      <text>待接单</text>
    </view>
    <view class="status-tab {{status === 2 ? 'active' : ''}}" bindtap="switchTab" data-status="2">
      <text>服务中</text>
    </view>
    <view class="status-tab {{status === 3 ? 'active' : ''}}" bindtap="switchTab" data-status="3">
      <text>已完成</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list">
    <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="order-header">
        <view class="order-shop-info">
          <text class="order-shop-icon">🧹</text>
          <text class="order-shop">{{item.merchantName || '服务'}}</text>
        </view>
        <text class="order-status {{statusClass[item.status] || ''}}">{{statusText[item.status] || '未知'}}</text>
      </view>
      <view class="order-body">
        <view class="order-info">
          <text class="order-title">{{item.serviceName || '服务'}}</text>
          <text class="order-time">预约时间: {{item.reserveTime || item.reserveDate}}</text>
          <text class="order-price">¥{{item.amount || item.price}}</text>
        </view>
      </view>
      <view class="order-footer">
        <view class="order-actions">
          <!-- 待付款：显示取消和去支付 -->
          <button class="action-btn cancel-btn" catchtap="cancelOrder" data-id="{{item.id}}" wx:if="{{item.status === 0}}">取消订单</button>
          <button class="action-btn pay-btn" catchtap="payOrder" data-id="{{item.id}}" data-amount="{{item.amount || item.price}}" wx:if="{{item.status === 0}}">去支付</button>
          <!-- 已完成：显示去评价 -->
          <button class="action-btn default-btn" catchtap="evaluateOrder" data-id="{{item.id}}" wx:if="{{item.status === 3}}">去评价</button>
          <!-- 其他状态显示查看详情 -->
          <button class="action-btn default-btn" catchtap="goToDetail" data-id="{{item.id}}" wx:if="{{item.status !== 0 && item.status !== 3}}">查看详情</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="loading-more" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>
  <view class="no-more" wx:if="{{!loading && !hasMore && orders.length > 0}}">
    <text class="no-more-text">— 没有更多了 —</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && orders.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无订单</text>
    <button class="empty-btn" bindtap="goToService">去逛逛</button>
  </view>

  <!-- 自定义底部导航栏 -->
  <custom-tab-bar role="user" active="/pages/order/list"></custom-tab-bar>
</view>
