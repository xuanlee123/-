<!--pages/order/create.wxml - 确认订单-->
<view class="create-container">
  <!-- 收货地址 -->
  <view class="section-card address-card" bindtap="selectAddress">
    <view class="address-row" wx:if="{{selectedAddress}}">
      <view class="address-info">
        <view class="address-user">
          <text class="user-name">{{selectedAddress.name}}</text>
          <text class="user-phone">{{selectedAddress.phone}}</text>
        </view>
        <text class="address-text">{{selectedAddress.region}} {{selectedAddress.detail}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="no-address" wx:if="{{!selectedAddress}}">
      <text class="no-address-text">请选择收货地址</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 服务信息 -->
  <view class="section-card">
    <view class="section-title-row">
      <text class="section-title-icon">🧹</text>
      <text class="section-title">服务信息</text>
    </view>
    <view class="service-row">
      <view class="service-info">
        <text class="service-name">{{serviceName}}</text>
        <text class="service-price">¥{{price}}</text>
      </view>
    </view>
  </view>

  <!-- 预约时间 -->
  <view class="section-card">
    <view class="section-title-row">
      <text class="section-title-icon">📅</text>
      <text class="section-title">预约时间</text>
    </view>
    <picker mode="date" bindchange="onDateChange" value="{{reserveDate}}">
      <view class="picker-row">
        <text class="picker-label">选择日期</text>
        <view class="picker-value">
          <text>{{reserveDate || '请选择'}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </picker>
    <picker mode="time" bindchange="onTimeChange" value="{{reserveTime}}">
      <view class="picker-row">
        <text class="picker-label">选择时间</text>
        <view class="picker-value">
          <text>{{reserveTime || '请选择'}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </picker>
  </view>

  <!-- 备注 -->
  <view class="section-card">
    <view class="section-title-row">
      <text class="section-title-icon">📝</text>
      <text class="section-title">备注</text>
    </view>
    <textarea class="remark-input" placeholder="请输入备注信息（选填）" bindinput="onRemarkInput" value="{{remark}}" maxlength="200"></textarea>
  </view>

  <!-- 价格明细 -->
  <view class="section-card">
    <view class="section-title-row">
      <text class="section-title-icon">💰</text>
      <text class="section-title">价格明细</text>
    </view>
    <view class="price-row">
      <text class="price-label">服务费</text>
      <text class="price-value">¥{{price}}</text>
    </view>
    <view class="price-row total-row">
      <text class="price-label">合计</text>
      <text class="total-price">¥{{price}}</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="price-info">
      <text class="price-label">实付款</text>
      <text class="total-price">¥{{price}}</text>
    </view>
    <button class="submit-btn" bindtap="submitOrder">提交订单</button>
  </view>
</view>
