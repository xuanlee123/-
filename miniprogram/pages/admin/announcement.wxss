/* pages/admin/announcement.wxss - 公告管理 */
page {
  background-color: var(--bg-page);
}

.announcement-container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding-bottom: 20rpx;
}

/* 头部 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: var(--bg-card);
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.btn-add {
  display: flex;
  align-items: center;
  background-color: var(--primary-color);
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
}

.add-icon {
  font-size: 28rpx;
  color: #FFFFFF;
  margin-right: 8rpx;
}

.add-text {
  font-size: 26rpx;
  color: #FFFFFF;
}

/* 公告列表 */
.announcement-list {
  padding: 0 32rpx;
}

/* 公告卡片 */
.announcement-card {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  margin-bottom: 16rpx;
}

.announcement-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background-color: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.icon-text {
  font-size: 40rpx;
}

.announcement-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.announcement-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.announcement-meta {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

.announcement-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  font-size: 28rpx;
}

/* 卡片内容 */
.card-content {
  background-color: var(--bg-gray);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.content-preview {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  gap: 40rpx;
}

.stat-item {
  display: flex;
  align-items: center;
}

.stat-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.stat-value {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

/* 状态标签 */
.status-tag {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.status-0 {
  background-color: #F5F5F5;
  color: #999999;
}

.status-1 {
  background-color: #F0F9EB;
  color: #52C41A;
}

/* 空/加载状态 */
.empty-state,
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 50vh;
}

.empty-text,
.loading-text {
  font-size: 28rpx;
  color: var(--text-placeholder);
}

/* ========== 表单弹窗 - 全屏居中方式 ========== */
.form-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-overlay-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.form-page {
  position: relative;
  z-index: 101;
  width: 90%;
  max-width: 700rpx;
  max-height: 85vh;
  background-color: var(--bg-card);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.form-page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid var(--border-light);
  flex-shrink: 0;
}

.form-page-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.form-page-close {
  font-size: 36rpx;
  color: var(--text-placeholder);
  padding: 8rpx;
}

.form-page-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 24rpx 32rpx;
  -webkit-overflow-scrolling: touch;
  max-height: 60vh;
}

.form-page-footer {
  display: flex;
  padding: 24rpx 32rpx;
  gap: 24rpx;
  border-top: 1rpx solid var(--border-light);
  flex-shrink: 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 表单元素 */
.form-group {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.form-group:last-child {
  border-bottom: none;
}

.form-group-vertical {
  flex-direction: column;
  align-items: flex-start;
}

.form-label {
  width: 140rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  text-align: right;
}

.form-picker-view {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  text-align: right;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  background-color: var(--bg-gray);
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
  line-height: 1.6;
}

/* 图片上传 */
.form-image-upload {
  flex: 1;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.form-image-preview {
  width: 100%;
  height: 100%;
}

.form-image-placeholder {
  width: 100%;
  height: 100%;
  background-color: var(--bg-gray);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.form-image-icon {
  font-size: 40rpx;
}

.form-image-text {
  font-size: 22rpx;
  color: var(--text-placeholder);
}

.form-image-clear {
  font-size: 24rpx;
  color: var(--danger-color);
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 按钮 */
.btn-cancel,
.btn-submit {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
}

.btn-cancel {
  background-color: var(--bg-gray);
  color: var(--text-secondary);
}

.btn-submit {
  background-color: var(--primary-color);
  color: #FFFFFF;
}

.btn-cancel::after,
.btn-submit::after {
  border: none;
}
