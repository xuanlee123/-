/* pages/admin/evaluation.wxss - 管理员评价监管页面 */
page {
  background-color: var(--bg-page);
}

.evaluation-container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding-bottom: 140rpx;
}

/* 头部 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: var(--bg-card);
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 统计数据 */
.stats-section {
  display: flex;
  padding: 24rpx 32rpx;
  gap: 16rpx;
  background-color: var(--bg-card);
  border-bottom: 1rpx solid var(--border-light);
}

.stat-card {
  flex: 1;
  background-color: var(--bg-page);
  border-radius: 12rpx;
  padding: 20rpx 12rpx;
  text-align: center;
}

.stat-card.warning {
  background-color: #FFF7E6;
}

.stat-card.danger {
  background-color: #FFF1F0;
}

.stat-card.success {
  background-color: #F6FFED;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.stat-card.warning .stat-value {
  color: #FA8C16;
}

.stat-card.danger .stat-value {
  color: #FF4D4F;
}

.stat-card.success .stat-value {
  color: #52C41A;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  background-color: var(--bg-card);
  padding: 20rpx 32rpx;
}

.filter-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-placeholder);
  padding: 12rpx 0;
  position: relative;
}

.filter-tab.active {
  color: var(--primary-color);
  font-weight: 500;
}

.filter-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background-color: var(--primary-color);
  border-radius: 2rpx;
}

/* 评价列表 */
.evaluation-list {
  height: calc(100vh - 400rpx);
  padding: 24rpx 32rpx;
}

.evaluation-card {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* 评价头部 */
.eval-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.eval-user {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.avatar-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.eval-time {
  font-size: 22rpx;
  color: var(--text-placeholder);
}

.eval-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.eval-status.pending {
  background-color: #FFF3E0;
  color: #FA8C16;
}

.eval-status.passed {
  background-color: #F0F9EB;
  color: #52C41A;
}

.eval-status.rejected {
  background-color: #FCEEEC;
  color: #FF4D4F;
}

/* 评分 */
.eval-score {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.score-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-right: 12rpx;
}

.stars {
  display: flex;
  margin-right: 12rpx;
}

.star {
  font-size: 32rpx;
  color: #E0E0E0;
  margin-right: 4rpx;
}

.star.active {
  color: #FFC107;
}

.score-value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

/* 评价内容 */
.eval-content {
  background-color: var(--bg-page);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.content-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

/* 评价图片 */
.eval-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.eval-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

/* 商户信息 */
.eval-merchant,
.eval-order {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.merchant-label,
.order-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-right: 8rpx;
}

.merchant-name,
.order-no {
  font-size: 24rpx;
  color: var(--text-primary);
}

/* 疑似差评标识 */
.negative-tag {
  display: inline-flex;
  align-items: center;
  background-color: #FFF1F0;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.tag-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.tag-text {
  font-size: 22rpx;
  color: #FF4D4F;
}

/* 商户回复 */
.merchant-reply {
  background-color: #F0F9EB;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 16rpx;
}

.reply-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.reply-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #52C41A;
}

.reply-time {
  font-size: 22rpx;
  color: var(--text-placeholder);
}

.reply-content {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.5;
}

/* 审核信息 */
.audit-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-light);
}

.audit-text {
  font-size: 22rpx;
  color: var(--text-placeholder);
}

/* 操作按钮 */
.eval-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-light);
}

.action-btn {
  font-size: 24rpx;
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
}

.action-btn.pass {
  background-color: var(--primary-color);
  color: #FFFFFF;
}

.action-btn.reject {
  background-color: var(--bg-gray);
  color: var(--danger-color);
}

/* 加载更多 */
.loading-more,
.no-more {
  text-align: center;
  padding: 32rpx;
}

.no-more-text {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

/* 空/加载状态 */
.empty-state,
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 50vh;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}

.empty-text,
.loading-text {
  font-size: 28rpx;
  color: var(--text-placeholder);
}

/* 管理员底部导航栏 */
.admin-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: var(--bg-card);
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.admin-tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 24rpx;
}

.admin-tabbar-item.active {
  color: var(--primary-color);
}

.admin-tabbar-item:not(.active) {
  color: var(--text-placeholder);
}

.admin-tabbar-icon {
  font-size: 44rpx;
  margin-bottom: 6rpx;
}

.admin-tabbar-text {
  font-size: 22rpx;
}
