/* pages/admin/data.wxss - 管理员数据页面 */
page {
  background-color: var(--bg-page);
}

.data-container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding-bottom: 120rpx;
}

/* 概览统计 */
.overview-section {
  padding: 30rpx 32rpx;
}

.overview-card {
  background-color: var(--primary-color);
  border-radius: 24rpx;
  padding: 40rpx;
}

.overview-header {
  margin-bottom: 16rpx;
}

.overview-title {
  font-size: 30rpx;
  color: #FFFFFF;
}

.overview-date {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 核心指标 */
.metrics-section {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.metric-card {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.metric-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.metric-icon {
  font-size: 40rpx;
}

.metric-value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.metric-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 统计卡片 */
.stats-card-section {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.stats-card-grid {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 30rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
}

.stats-card-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-card-value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-bottom: 8rpx;
}

.stats-card-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 趋势图 */
.trend-section {
  padding: 0 32rpx;
}

.trend-chart {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 30rpx;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 250rpx;
  padding: 0 20rpx;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.bar {
  width: 40rpx;
  background-color: var(--primary-color);
  border-radius: 8rpx 8rpx 0 0;
  margin-bottom: 12rpx;
  min-height: 10rpx;
}

.bar-label {
  font-size: 22rpx;
  color: var(--text-placeholder);
}

.bar-value {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* 管理员底部导航栏 */
.admin-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: var(--bg-card);
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.admin-tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 40rpx;
}

.admin-tabbar-item.active {
  color: var(--primary-color);
}

.admin-tabbar-item:not(.active) {
  color: var(--text-placeholder);
}

.admin-tabbar-icon {
  font-size: 44rpx;
  margin-bottom: 6rpx;
}

.admin-tabbar-text {
  font-size: 22rpx;
}
