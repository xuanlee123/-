<!--pages/admin/index.wxml - 管理员工作台-->
<view class="admin-container">
  <!-- 头部 -->
  <view class="admin-header">
    <view class="header-content">
      <view class="header-info">
        <text class="header-title">👔 管理员工作台</text>
        <text class="header-date">{{currentDate}}</text>
      </view>
      <view class="admin-avatar">
        <text class="avatar-text">管</text>
      </view>
    </view>
  </view>

  <!-- 运营管理部 -->
  <view class="stats-section">
    <view class="section-title">
      <text class="title-icon">📊</text>
      <text class="title-text">运营管理部</text>
    </view>
    <view class="stats-grid">
      <view class="stat-card" bindtap="goToOrder">
        <view class="stat-icon-box" style="background-color: #E8F8F5">
          <text class="stat-icon">📋</text>
        </view>
        <view class="stat-content">
          <text class="stat-value">{{stats.todayOrders}}</text>
          <text class="stat-label">今日订单</text>
        </view>
      </view>
      <view class="stat-card" bindtap="goToPending">
        <view class="stat-icon-box" style="background-color: #FFF3E0">
          <text class="stat-icon">⏰</text>
        </view>
        <view class="stat-content">
          <text class="stat-value">{{stats.pendingAudit}}</text>
          <text class="stat-label">待审核</text>
        </view>
      </view>
      <view class="stat-card" bindtap="goToComplaint">
        <view class="stat-icon-box" style="background-color: #FFEBEE">
          <text class="stat-icon">⚠️</text>
        </view>
        <view class="stat-content">
          <text class="stat-value">{{stats.complaints}}</text>
          <text class="stat-label">投诉</text>
        </view>
      </view>
      <view class="stat-card" bindtap="goToUser">
        <view class="stat-icon-box" style="background-color: #E3F2FD">
          <text class="stat-icon">👥</text>
        </view>
        <view class="stat-content">
          <text class="stat-value">{{stats.users}}</text>
          <text class="stat-label">用户数</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 运营管理板块 -->
  <view class="function-section">
    <view class="section-title">
      <text class="title-icon">⚙️</text>
      <text class="title-text">运营管理板块</text>
    </view>
    <view class="function-grid">
      <view class="function-item" bindtap="goToUserManage">
        <view class="function-icon-box" style="background-color: #E3F2FD">
          <text class="function-icon">👤</text>
        </view>
        <text class="function-text">账户管理</text>
      </view>
      <view class="function-item" bindtap="goToReview">
        <view class="function-icon-box" style="background-color: #F3E5F5">
          <text class="function-icon">⭐</text>
        </view>
        <text class="function-text">评价审核</text>
      </view>
      <view class="function-item" bindtap="goToAnnouncement">
        <view class="function-icon-box" style="background-color: #E8F8F5">
          <text class="function-icon">📢</text>
        </view>
        <text class="function-text">公告管理</text>
      </view>
      <view class="function-item" bindtap="goToActivity">
        <view class="function-icon-box" style="background-color: #FFEBEE">
          <text class="function-icon">🎊</text>
        </view>
        <text class="function-text">活动管理</text>
      </view>
      <view class="function-item" bindtap="goToNeighborhood">
        <view class="function-icon-box" style="background-color: #FFF9C4">
          <text class="function-icon">🌐</text>
        </view>
        <text class="function-text">邻里圈监管</text>
      </view>
      <view class="function-item" bindtap="goToOrderMonitor">
        <view class="function-icon-box" style="background-color: #ECEFF1">
          <text class="function-icon">📦</text>
        </view>
        <text class="function-text">订单监管</text>
      </view>
    </view>
  </view>

  <!-- 待审核商户 -->
  <view class="pending-section">
    <view class="section-header">
      <view class="section-title-row">
        <text class="title-icon">🏪</text>
        <text class="title-text">待审核商户</text>
        <view class="badge" wx:if="{{stats.pendingMerchants > 0}}">{{stats.pendingMerchants}}</view>
      </view>
      <text class="more-btn" bindtap="goToMerchant">查看全部 ></text>
    </view>
    <view class="merchant-list" wx:if="{{pendingMerchants.length > 0}}">
      <view class="merchant-item" wx:for="{{pendingMerchants}}" wx:key="id">
        <view class="merchant-info">
          <view class="merchant-avatar">
            <text class="avatar-text">{{item.avatarText}}</text>
          </view>
          <view class="merchant-detail">
            <text class="merchant-name">{{item.name}}</text>
            <text class="merchant-time">申请时间：{{item.createTime}}</text>
          </view>
        </view>
        <view class="merchant-actions">
          <view class="action-btn reject" bindtap="rejectMerchant" data-id="{{item.id}}">驳回</view>
          <view class="action-btn pass" bindtap="passMerchant" data-id="{{item.id}}">通过</view>
        </view>
      </view>
    </view>
    <view class="empty-merchant" wx:else>
      <text class="empty-text">暂无待审核商户</text>
    </view>
  </view>

  <!-- 管理员固定底部导航栏 -->
  <view class="admin-tabbar">
    <view class="admin-tabbar-item active">
      <text class="admin-tabbar-icon">🏠</text>
      <text class="admin-tabbar-text">工作台</text>
    </view>
    <view class="admin-tabbar-item" bindtap="switchTab" data-tab="data">
      <text class="admin-tabbar-icon">📊</text>
      <text class="admin-tabbar-text">数据</text>
    </view>
    <view class="admin-tabbar-item" bindtap="switchTab" data-tab="order">
      <text class="admin-tabbar-icon">📋</text>
      <text class="admin-tabbar-text">订单</text>
    </view>
    <view class="admin-tabbar-item" bindtap="switchTab" data-tab="mine">
      <text class="admin-tabbar-icon">👤</text>
      <text class="admin-tabbar-text">我的</text>
    </view>
  </view>
</view>
