/* pages/admin/merchant.wxss - 管理员商户管理页面 */
page {
  background-color: var(--bg-page);
}

.merchant-container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding-bottom: 120rpx;
}

/* 头部 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: var(--bg-card);
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  background-color: var(--bg-card);
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.filter-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-placeholder);
  padding: 12rpx 0;
  position: relative;
}

.filter-tab.active {
  color: var(--primary-color);
  font-weight: 500;
}

.filter-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background-color: var(--primary-color);
  border-radius: 2rpx;
}

.tab-badge {
  display: inline-block;
  background-color: var(--danger-color);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 8rpx;
}

/* 商户列表 */
.merchant-list {
  height: calc(100vh - 200rpx);
  padding: 24rpx 32rpx;
}

.merchant-card {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.merchant-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.merchant-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  background-color: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.merchant-info {
  flex: 1;
  min-width: 0;
}

.merchant-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.merchant-contact {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 4rpx;
}

.merchant-time {
  font-size: 22rpx;
  color: var(--text-placeholder);
  display: block;
}

.merchant-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.merchant-status.pending {
  background-color: #FFF3E0;
  color: #FA8C16;
}

.merchant-status.approved {
  background-color: #F0F9EB;
  color: #52C41A;
}

.merchant-status.rejected {
  background-color: #FCEEEC;
  color: #FF4D4F;
}

.merchant-detail {
  display: flex;
  margin-bottom: 12rpx;
}

.detail-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.detail-value {
  font-size: 24rpx;
  color: var(--text-primary);
  flex: 1;
}

.merchant-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-light);
}

.action-btn {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
}

.action-btn.view {
  background-color: var(--bg-gray);
  color: var(--text-secondary);
}

.action-btn.license {
  background-color: #E8F4FD;
  color: #1890FF;
}

.action-btn.pass {
  background-color: var(--primary-color);
  color: #FFFFFF;
}

.action-btn.reject {
  background-color: var(--bg-gray);
  color: var(--danger-color);
}

.audit-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-light);
}

.audit-text {
  font-size: 22rpx;
  color: var(--text-placeholder);
}

/* 空/加载状态 */
.empty-state,
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 50vh;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}

.empty-text,
.loading-text {
  font-size: 28rpx;
  color: var(--text-placeholder);
}

/* 管理员底部导航栏 */
.admin-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: var(--bg-card);
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.admin-tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 40rpx;
}

.admin-tabbar-item.active {
  color: var(--primary-color);
}

.admin-tabbar-item:not(.active) {
  color: var(--text-placeholder);
}

.admin-tabbar-icon {
  font-size: 44rpx;
  margin-bottom: 6rpx;
}

.admin-tabbar-text {
  font-size: 22rpx;
}
