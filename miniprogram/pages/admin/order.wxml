<!--pages/admin/order.wxml - 管理员订单管理页面-->
<view class="order-container">
  <!-- 筛选标签 -->
  <view class="filter-tabs">
    <view class="tab-item {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchStatus" data-tab="all">
      <text class="tab-text">全部</text>
      <view class="tab-badge" wx:if="{{counts.all > 0}}">{{counts.all}}</view>
    </view>
    <view class="tab-item {{currentTab === 'pending' ? 'active' : ''}}" bindtap="switchStatus" data-tab="pending">
      <text class="tab-text">待付款</text>
      <view class="tab-badge" wx:if="{{counts.pending > 0}}">{{counts.pending}}</view>
    </view>
    <view class="tab-item {{currentTab === 'paid' ? 'active' : ''}}" bindtap="switchStatus" data-tab="paid">
      <text class="tab-text">待接单</text>
      <view class="tab-badge" wx:if="{{counts.paid > 0}}">{{counts.paid}}</view>
    </view>
    <view class="tab-item {{currentTab === 'processing' ? 'active' : ''}}" bindtap="switchStatus" data-tab="processing">
      <text class="tab-text">服务中</text>
      <view class="tab-badge" wx:if="{{counts.processing > 0}}">{{counts.processing}}</view>
    </view>
    <view class="tab-item {{currentTab === 'completed' ? 'active' : ''}}" bindtap="switchStatus" data-tab="completed">
      <text class="tab-text">已完成</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <scroll-view scroll-y class="order-list" bindscrolltolower="loadMore">
    <view class="order-card" wx:for="{{orders}}" wx:key="id">
      <!-- 订单头部 -->
      <view class="order-header">
        <view class="order-merchant">
          <text class="merchant-icon">🏪</text>
          <text class="merchant-name">{{item.merchantName}}</text>
        </view>
        <text class="order-status status-{{item.statusClass}}">{{item.statusText}}</text>
      </view>

      <!-- 订单内容 -->
      <view class="order-content" bindtap="goToDetail" data-id="{{item.id}}">
        <view class="order-service">
          <text class="service-name">{{item.serviceName}}</text>
          <text class="service-desc">{{item.description}}</text>
        </view>
        <view class="order-price">
          <text class="price-value">¥{{item.amount}}</text>
          <text class="price-count">x1</text>
        </view>
      </view>

      <!-- 订单信息 -->
      <view class="order-info">
        <text class="info-text">{{item.userName || '未知用户'}} | {{item.phone || '无'}}</text>
        <text class="info-address">{{item.address || '无地址'}}</text>
      </view>

      <!-- 订单时间 -->
      <view class="order-time">
        <text class="time-text">下单：{{item.createTime || '无'}}</text>
        <text class="time-text">预约：{{item.appointmentTime || '无'}}</text>
      </view>

      <!-- 操作按钮 -->
      <view class="order-actions" wx:if="{{item.status === 1}}">
        <view class="action-btn cancel" bindtap="cancelOrder" data-id="{{item.id}}">取消订单</view>
        <view class="action-btn confirm" bindtap="confirmPayment" data-id="{{item.id}}">确认收款</view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="loading-more" wx:if="{{hasMore}}">
      <text class="loading-text">加载中...</text>
    </view>
    <view class="no-more" wx:if="{{!hasMore && orders.length > 0}}">
      <text class="no-more-text">没有更多订单了</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{orders.length === 0 && !loading}}">
      <text class="empty-icon">📦</text>
      <text class="empty-text">暂无订单</text>
    </view>
  </scroll-view>

  <!-- 管理员固定底部导航栏 -->
  <view class="admin-tabbar">
    <view class="admin-tabbar-item" bindtap="switchTab" data-tab="index">
      <text class="admin-tabbar-icon">🏠</text>
      <text class="admin-tabbar-text">工作台</text>
    </view>
    <view class="admin-tabbar-item" bindtap="switchTab" data-tab="data">
      <text class="admin-tabbar-icon">📊</text>
      <text class="admin-tabbar-text">数据</text>
    </view>
    <view class="admin-tabbar-item active">
      <text class="admin-tabbar-icon">📋</text>
      <text class="admin-tabbar-text">订单</text>
    </view>
    <view class="admin-tabbar-item" bindtap="switchTab" data-tab="evaluation">
      <text class="admin-tabbar-icon">⭐</text>
      <text class="admin-tabbar-text">评价</text>
    </view>
    <view class="admin-tabbar-item" bindtap="switchTab" data-tab="mine">
      <text class="admin-tabbar-icon">👤</text>
      <text class="admin-tabbar-text">我的</text>
    </view>
  </view>
</view>
