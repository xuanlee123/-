<!--pages/admin/mine.wxml - 管理员我的页面-->
<view class="mine-container">
  <!-- 用户信息卡片 -->
  <view class="admin-card">
    <view class="admin-info">
      <view class="admin-avatar">
        <text class="avatar-text">👔</text>
      </view>
      <view class="admin-detail">
        <text class="admin-name">{{userInfo.nickname || '管理员'}}</text>
        <text class="admin-role">系统管理员</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="section-title">
      <text class="title-icon">⚙️</text>
      <text class="title-text">运营管理</text>
    </view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToAnnouncement">
        <text class="menu-icon">📢</text>
        <text class="menu-text">公告管理</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToActivity">
        <text class="menu-icon">🎊</text>
        <text class="menu-text">活动管理</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToNeighborhood">
        <text class="menu-icon">🌐</text>
        <text class="menu-text">邻里圈监管</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 系统设置 -->
  <view class="menu-section">
    <view class="section-title">
      <text class="title-icon">🛠️</text>
      <text class="title-text">系统设置</text>
    </view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToSettings">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">设置</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToAbout">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">关于系统</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <!-- 管理员固定底部导航栏 -->
  <view class="admin-tabbar">
    <view class="admin-tabbar-item" bindtap="switchTab" data-tab="index">
      <text class="admin-tabbar-icon">🏠</text>
      <text class="admin-tabbar-text">工作台</text>
    </view>
    <view class="admin-tabbar-item" bindtap="switchTab" data-tab="data">
      <text class="admin-tabbar-icon">📊</text>
      <text class="admin-tabbar-text">数据</text>
    </view>
    <view class="admin-tabbar-item" bindtap="switchTab" data-tab="order">
      <text class="admin-tabbar-icon">📋</text>
      <text class="admin-tabbar-text">订单</text>
    </view>
    <view class="admin-tabbar-item active">
      <text class="admin-tabbar-icon">👤</text>
      <text class="admin-tabbar-text">我的</text>
    </view>
  </view>
</view>
