/* pages/admin/user.wxss - 用户管理 */
page {
  background-color: var(--bg-page);
}

.user-admin-container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding-bottom: 20rpx;
}

/* 头部 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: var(--bg-card);
  margin-bottom: 0;
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.search-box {
  display: flex;
  align-items: center;
  background-color: var(--bg-gray);
  border-radius: 40rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  gap: 12rpx;
}

.search-input {
  width: 200rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

.search-btn {
  font-size: 26rpx;
  color: #FFFFFF;
  background-color: var(--primary-color);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  background-color: var(--bg-card);
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.filter-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-placeholder);
  padding: 12rpx 0;
  position: relative;
}

.filter-tab.active {
  color: var(--primary-color);
  font-weight: 500;
}

.filter-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background-color: var(--primary-color);
  border-radius: 2rpx;
}

/* 用户列表 */
.user-list {
  padding: 0 32rpx;
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-top: 20rpx;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-icon {
  font-size: 50rpx;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  gap: 12rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-role {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.user-role.role-1 { background-color: #F0F9EB; color: #52C41A; }
.user-role.role-2 { background-color: #FFF3E0; color: #FA8C16; }
.user-role.role-3 { background-color: #E8F4FD; color: #1890FF; }

.user-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.user-status.status-1 { background-color: #F0F9EB; color: #52C41A; }
.user-status.status-0 { background-color: #FCEEEC; color: #FF4D4F; }

.user-phone {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 6rpx;
}

.user-time {
  display: block;
  font-size: 22rpx;
  color: var(--text-placeholder);
}

.user-actions {
  padding: 16rpx;
  flex-shrink: 0;
}

.action-icon {
  font-size: 32rpx;
  color: var(--text-placeholder);
  font-weight: bold;
}

/* 空/加载状态 */
.empty-state,
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 50vh;
}

.empty-text,
.loading-text {
  font-size: 28rpx;
  color: var(--text-placeholder);
}

/* 操作菜单 */
.action-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

.action-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--bg-card);
  border-radius: 24rpx 24rpx 0 0;
  z-index: 201;
  transform: translateY(100%);
  transition: transform 0.3s;
}

.action-sheet.show {
  transform: translateY(0);
}

.sheet-header {
  padding: 40rpx 32rpx 24rpx;
  border-bottom: 1rpx solid var(--border-light);
  text-align: center;
}

.sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.sheet-sub {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

.sheet-options {
  padding: 16rpx 0;
}

.sheet-option {
  display: flex;
  align-items: center;
  padding: 32rpx 48rpx;
  gap: 20rpx;
}

.sheet-option.enable .option-icon { color: #52C41A; }
.sheet-option.disable .option-icon { color: #FF4D4F; }
.sheet-option.reset .option-icon { color: #1890FF; }

.option-icon {
  font-size: 36rpx;
}

.option-text {
  font-size: 30rpx;
  color: var(--text-primary);
}

.sheet-cancel {
  padding: 32rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--text-secondary);
  background-color: var(--bg-gray);
  border-top: 1rpx solid var(--border-light);
}
