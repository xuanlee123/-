/* pages/admin/order.wxss - 管理员订单管理页面 */
page {
  background-color: var(--bg-page);
}

.order-container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding-bottom: 120rpx;
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  background-color: var(--bg-card);
  padding: 20rpx 0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  padding: 10rpx 0;
}

.tab-text {
  font-size: 28rpx;
  color: var(--text-placeholder);
}

.tab-item.active .tab-text {
  color: var(--primary-color);
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background-color: var(--primary-color);
  border-radius: 2rpx;
}

.tab-badge {
  background-color: var(--danger-color);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-top: 6rpx;
}

/* 订单列表 */
.order-list {
  height: calc(100vh - 120rpx);
  padding: 24rpx 32rpx;
}

.order-card {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.order-merchant {
  display: flex;
  align-items: center;
}

.merchant-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.merchant-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.order-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.status-pending {
  background-color: #FDF6EC;
  color: var(--warning-color);
}

.status-paid {
  background-color: var(--primary-light);
  color: var(--primary-color);
}

.status-processing {
  background-color: #F5EEF8;
  color: #9C27B0;
}

.status-completed {
  background-color: #F0F9EB;
  color: var(--success-color);
}

.status-cancelled {
  background-color: var(--bg-gray);
  color: var(--text-placeholder);
}

.order-content {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--border-light);
  border-bottom: 1rpx solid var(--border-light);
}

.order-service {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.service-name {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.service-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.order-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 20rpx;
}

.price-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.price-count {
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 8rpx;
}

.order-info {
  margin-top: 16rpx;
}

.info-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 4rpx;
}

.info-address {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
}

.order-time {
  margin-top: 16rpx;
  display: flex;
  gap: 20rpx;
}

.time-text {
  font-size: 22rpx;
  color: var(--text-placeholder);
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-light);
}

.action-btn {
  font-size: 26rpx;
  padding: 14rpx 32rpx;
  border-radius: 40rpx;
}

.action-btn.cancel {
  background-color: var(--bg-card);
  color: var(--text-secondary);
  border: 1rpx solid var(--border-color);
}

.action-btn.confirm {
  background-color: var(--primary-color);
  color: #FFFFFF;
}

/* 加载状态 */
.loading-more,
.no-more {
  text-align: center;
  padding: 40rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-placeholder);
}

.no-more-text {
  font-size: 26rpx;
  color: var(--text-placeholder);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-placeholder);
}

/* 管理员底部导航栏 */
.admin-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: var(--bg-card);
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.admin-tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 40rpx;
}

.admin-tabbar-item.active {
  color: var(--primary-color);
}

.admin-tabbar-item:not(.active) {
  color: var(--text-placeholder);
}

.admin-tabbar-icon {
  font-size: 44rpx;
  margin-bottom: 6rpx;
}

.admin-tabbar-text {
  font-size: 22rpx;
}
