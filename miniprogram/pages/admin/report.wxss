/* pages/admin/report.wxss - 数据报表 */
page {
  background-color: var(--bg-page);
}

.report-container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding-bottom: 20rpx;
}

/* 时间筛选 */
.time-filter {
  display: flex;
  background-color: var(--bg-card);
  padding: 20rpx 32rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 30rpx;
  margin-right: 16rpx;
}

.filter-item:last-child {
  margin-right: 0;
}

.filter-item.active {
  background-color: var(--primary-color);
}

.filter-item text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.filter-item.active text {
  color: #FFFFFF;
}

/* 概览卡片 */
.overview-section {
  padding: 30rpx 32rpx;
}

.overview-card {
  background-color: var(--primary-color);
  border-radius: 24rpx;
  padding: 40rpx;
}

.overview-title {
  font-size: 30rpx;
  color: #FFFFFF;
  margin-bottom: 12rpx;
  display: block;
}

.overview-value {
  font-size: 56rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: block;
  margin-bottom: 12rpx;
}

.overview-trend {
  display: flex;
  align-items: center;
}

.trend-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.trend-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 数据卡片 */
.metrics-section {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.metric-card {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.metric-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.metric-icon {
  font-size: 40rpx;
}

.metric-value {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.metric-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.metric-trend {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
}

.metric-trend.up {
  background-color: #F0F9EB;
  color: var(--success-color);
}

/* 图表区域 */
.chart-section,
.ranking-section {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.chart-card {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 30rpx;
}

.chart-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.chart-item:last-child {
  margin-bottom: 0;
}

.chart-label {
  display: flex;
  align-items: center;
  width: 160rpx;
}

.label-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.label-text {
  font-size: 26rpx;
  color: var(--text-primary);
}

.chart-bar-wrapper {
  flex: 1;
  height: 24rpx;
  background-color: var(--bg-gray);
  border-radius: 12rpx;
  margin: 0 16rpx;
}

.chart-bar {
  height: 100%;
  border-radius: 12rpx;
}

.chart-value {
  width: 80rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: right;
}

/* 排行卡片 */
.ranking-card {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.ranking-item:last-child {
  border-bottom: none;
}

.ranking-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: var(--bg-gray);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-right: 20rpx;
}

.ranking-rank.gold {
  background-color: #FFD700;
  color: #FFFFFF;
}

.ranking-rank.silver {
  background-color: #C0C0C0;
  color: #FFFFFF;
}

.ranking-rank.bronze {
  background-color: #CD7F32;
  color: #FFFFFF;
}

.ranking-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ranking-name {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.ranking-sales {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

.ranking-revenue {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}
