/* pages/admin/index.wxss - 管理员工作台 */
page {
  background-color: var(--bg-page);
}

.admin-container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding-bottom: 140rpx;
}

/* 管理员固定底部导航栏 */
.admin-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: var(--bg-card);
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

/* 头部 */
.admin-header {
  background-color: var(--primary-color);
  padding: 40rpx 32rpx;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-info {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.header-date {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.admin-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* 数据统计 */
.stats-section {
  padding: 30rpx 32rpx;
  margin-top: -40rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.stat-card {
  display: flex;
  align-items: center;
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
}

.stat-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.stat-icon {
  font-size: 40rpx;
}

.stat-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 功能入口 */
.function-section {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.title-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.function-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 32rpx;
}

.function-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.function-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.function-icon {
  font-size: 40rpx;
}

.function-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 待审核商户 */
.pending-section {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
}

.badge {
  background-color: var(--danger-color);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
}

.more-btn {
  font-size: 26rpx;
  color: var(--text-placeholder);
}

.merchant-list {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
}

.merchant-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.merchant-item:last-child {
  border-bottom: none;
}

.merchant-info {
  display: flex;
  align-items: center;
}

.merchant-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background-color: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.merchant-detail {
  display: flex;
  flex-direction: column;
}

.merchant-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.merchant-time {
  font-size: 22rpx;
  color: var(--text-placeholder);
}

.merchant-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
}

.action-btn.reject {
  background-color: var(--bg-gray);
  color: var(--text-secondary);
}

.action-btn.pass {
  background-color: var(--primary-color);
  color: #FFFFFF;
}

/* 最新订单 */
.order-section {
  padding: 0 32rpx;
}

.order-list {
  background-color: var(--bg-card);
  border-radius: 20rpx;
}

.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.order-item:last-child {
  border-bottom: none;
}

.order-info {
  display: flex;
  flex-direction: column;
}

.order-title {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.order-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.order-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.order-status.pending {
  background-color: #FDF6EC;
  color: var(--warning-color);
}

.order-status.processing {
  background-color: var(--primary-light);
  color: var(--primary-color);
}

.order-status.completed {
  background-color: #F0F9EB;
  color: var(--success-color);
}

/* 空状态 */
.empty-merchant {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 60rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-placeholder);
}

/* 管理员底部导航栏 */
.admin-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: var(--bg-card);
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.admin-tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 40rpx;
}

.admin-tabbar-item.active {
  color: var(--primary-color);
}

.admin-tabbar-item:not(.active) {
  color: var(--text-placeholder);
}

.admin-tabbar-icon {
  font-size: 44rpx;
  margin-bottom: 6rpx;
}

.admin-tabbar-text {
  font-size: 22rpx;
}
