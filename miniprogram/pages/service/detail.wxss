/* pages/service/detail.wxss - 服务详情 */
page {
  background-color: var(--bg-page);
}

.service-detail-container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* 服务轮播图 */
.service-swiper {
  height: 500rpx;
  background-color: var(--bg-card);
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.swiper-image-box {
  width: 100%;
  height: 100%;
  background-color: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.swiper-image-text {
  font-size: 120rpx;
}

/* 服务信息 */
.service-info-section {
  background-color: var(--bg-card);
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.price-wrap {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.service-price {
  font-size: 56rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.service-tag {
  font-size: 24rpx;
  color: var(--primary-color);
  background-color: var(--primary-light);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.service-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.service-stats {
  display: flex;
  gap: 30rpx;
  flex-wrap: wrap;
}

.stat-item {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 商户信息 */
.merchant-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: var(--bg-card);
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
}

.merchant-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.merchant-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.merchant-avatar-text {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.merchant-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.merchant-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.merchant-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.bottom-btns {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.btn-book {
  padding: 24rpx 60rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  background: var(--primary-color);
  color: #FFFFFF;
}

.btn-book::after {
  border: none;
}
.desc-section {
  background-color: var(--bg-card);
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-more {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

.desc-content {
  display: flex;
  flex-direction: column;
}

.desc-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  margin-bottom: 8rpx;
}

/* 用户评价 */
.comment-section {
  background-color: var(--bg-card);
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.comment-empty {
  text-align: center;
  padding: 40rpx 0;
}

.comment-empty-text {
  font-size: 28rpx;
  color: var(--text-placeholder);
}

.comment-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: var(--bg-gray);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.comment-avatar-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.comment-user {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.comment-username {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.comment-rating {
  display: flex;
}

.star {
  font-size: 20rpx;
  letter-spacing: -4rpx;
}

.comment-time {
  font-size: 22rpx;
  color: var(--text-placeholder);
}

.comment-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: env(safe-area-inset-bottom);
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: var(--bg-card);
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.bottom-actions {
  display: flex;
  margin-right: 30rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 20rpx;
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.action-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.bottom-btns {
  flex: 1;
  display: flex;
  gap: 20rpx;
}

.btn-book {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.btn-book {
  background: var(--primary-color);
  color: #FFFFFF;
}

.btn-consult::after,
.btn-book::after {
  border: none;
}
